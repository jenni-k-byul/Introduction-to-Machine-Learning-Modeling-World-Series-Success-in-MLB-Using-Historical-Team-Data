# ---------- Load Packages ----------
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from IPython.display import display
from sklearn import preprocessing
from sklearn.preprocessing import MinMaxScaler
from statsmodels.stats.outliers_influence import variance_inflation_factor

# ---------- Load Dataset ----------
mlb_stats = pd.read_csv('')

display(mlb_stats)

# ============================================================
# EDA - Dataframe Info
# ============================================================

## Set pandas display option to show all rows
pd.set_option('display.max_rows', None)

## Check shape of mlb_stats df
print("Shape:", mlb_stats.shape)

## Number of obs per each column and type of data
mlb_stats.info()

## Statistical summary
display(mlb_stats.describe().T)

## Check for missing values
display(mlb_stats.isnull().sum())

## Check for any duplicate rows
duplicate_rows_df = mlb_stats[mlb_stats.duplicated()]
print("number of duplicate rows: ", duplicate_rows_df.shape)

# ============================================================
# Correlation Matrix
# ============================================================

## Drop text columns
mlb_stats_num = mlb_stats.drop(["Year", "Tm", "Winner"], axis = 1)

display(mlb_stats_num)

## Calculate matrix of correlations
mlb_corr = mlb_stats_num.corr()
print(mlb_corr)

## Find correlation higher than 0.8
## Find correlation lower than -0.8
threshold_pos = 0.8
threshold_neg = -0.8

corr_pairs = mlb_corr.unstack().sort_values(ascending = False)

high_corr = corr_pairs[corr_pairs > threshold_pos]
low_corr = corr_pairs[corr_pairs < threshold_neg]

print(high_corr.to_string())
print(low_corr.to_string())

## Correlation heatmap
plt.figure(figsize = (40, 30))

sns.heatmap(mlb_stats_num.corr())

plt.title('Correlation Heatmap')

plt.savefig('mlb_heatmap.png', dpi = 300)

plt.show()

## Correlation with World Series wins
plt.figure(figsize=(8, 20))

# Get correlations
target_corr = mlb_stats_num.corr()[['WS_win']].sort_values(by = 'WS_win', ascending = False)

sns.heatmap(target_corr,
            annot = True,
            vmin = -1,
            vmax = 1)

plt.title('Feature Correlation with World Series Wins')
plt.savefig('WS_win_corr.png', dpi = 300)

plt.show()

# ============================================================
# VIF
# ============================================================

X = mlb_stats_num.copy()
X = X.dropna()

display(X)

vif_data = pd.DataFrame()

vif_data["feature"] = X.columns

vif_data["VIF"] = [variance_inflation_factor(X.values, i)
                   for i in range(len(X.columns))]

print(vif_data)

vif_data = vif_data.sort_values(by = 'VIF', ascending = False)
display(vif_data)

print(vif_data["VIF"].mean())

