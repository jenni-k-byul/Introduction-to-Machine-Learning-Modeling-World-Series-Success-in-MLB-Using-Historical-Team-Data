# ============================================================
# MODEL 3 - Logistic Regression with Two-Way Fixed Effects (TWFE)
# ============================================================
# References:
# - https://scikit-learn.org/stable/modules/generated/sklearn.compose.ColumnTransformer.html
# - https://stackoverflow.com/questions/24195432/fixed-effect-in-pandas-or-statsmodels
# - https://stats.stackexchange.com/questions/596576/fixed-effects-on-machine-learning-models
# - https://www.youtube.com/watch?v=9NfSGzuZSo4

## Drop columns irrelevant for modeling (including missing columns)
## (Year and Tm are kept here to serve as fixed effects)
mlb_stats_cleaned = mlb_stats.drop(["Winner", "fld_Rdrs", "fld_Rdrs/yr", "fld_Rgood", "fld_Rtot", "fld_Rtot/yr", "bat_SF"], axis = 1)

display(mlb_stats_cleaned)

## Split mlb_stats into X and Y
X = mlb_stats_cleaned.drop(columns = ['WS_win'])
Y = mlb_stats_cleaned['WS_win']

## Define fixed_effect columns - Year and Tm (team)
fixed_effect_cols = ['Year', 'Tm']
numeric_features = [col for col in X.columns if col not in fixed_effect_cols]

## Build preprocessor
preprocessor = ColumnTransformer(transformers=[('num', StandardScaler(), numeric_features),
                                               ('cat', OneHotEncoder(drop = 'first', handle_unknown = 'ignore'), fixed_effect_cols)])

# ---------- Logistic Regression with fixed effect ----------

## Split data
X_train, X_test, y_train, y_test = train_test_split(X,
                                                    Y,
                                                    test_size = 0.2,
                                                    random_state = 524,
                                                    stratify = Y)

## Define k-fold validation
K = 10

kfold = StratifiedKFold(K,
                        random_state = 1110,
                        shuffle = True)

C_range = np.logspace(-8, 3, 10)

print(C_range)

log_reg_cv = LogisticRegressionCV(Cs = C_range,
                                  cv = kfold,
                                  max_iter = 10000,
                                  class_weight = 'balanced')

pipe_twfe = Pipeline(steps=[('preprocessor', preprocessor),
                            ('logistic', log_reg_cv)])


pipe_twfe.fit(X_train, y_train)

# Extract feature names from the preprocessor
cat_features = pipe_twfe.named_steps['preprocessor']\
               .named_transformers_['cat']\
               .get_feature_names_out(fixed_effect_cols)

all_features = numeric_features + list(cat_features)

# Get the coefficients from the logistic model
coeffs = pipe_twfe.named_steps['logistic'].coef_[0]

# Create a clean DataFrame of results
results = pd.DataFrame({'Feature': all_features,
                        'Coefficient': coeffs})

results = results.sort_values(by = 'Coefficient',
                              ascending = False)

display(results)

best_c = pipe_twfe.named_steps['logistic'].C_
print(f"The optimal regularization strength (C) was: {best_c}")

predictions = pipe_twfe.predict(X_test)
print(confusion_matrix(y_test, predictions))
print(classification_report(y_test, predictions))

## Construct Confusion Matrix
c_matrix_twfe = confusion_matrix(y_test, predictions)

ConfusionMatrixDisplay(c_matrix_twfe, display_labels=['No WS Win', 'WS Win']).plot()
plt.show()

# Get the predicted probabilities
y_probs = pipe_twfe.predict_proba(X_test)[:, 1]

# Calculate the precision and recall
precision, recall, thresholds = precision_recall_curve(y_test, y_probs)

# Calculate AUC
pr_auc_score = auc(recall, precision)

print(f"The PR-AUC Score is: {pr_auc_score:.4f}")

plt.figure(figsize = (8, 6))
plt.plot(recall,
         precision,
         label  = f'Logistic + TWFE (PR-AUC = {pr_auc_score:.2f})',
         color = 'b')


plt.xlabel('Recall')
plt.ylabel('Precision')
plt.title('Precision-Recall Curve')
plt.legend()
plt.show()

# ---------- Save PR-AUC Globally ----------

## Save PR AUC to a df for global export
model_name = "Logistic Regression - TWFE"

log_twfe_df = pd.DataFrame({'precision': precision,
                            'recall': recall})

display(log_twfe_df)

dump(log_twfe_df, 'log_twfe.joblib')

