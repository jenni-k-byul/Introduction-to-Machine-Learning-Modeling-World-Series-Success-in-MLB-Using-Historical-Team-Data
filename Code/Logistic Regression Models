# Mac
mlb_stats = pd.read_csv('')

display(mlb_stats)

# ============================================================
# MODEL 1 - Logistic Regression (Baseline)
# ============================================================

## Drop columns irrelevant for modeling 
mlb_stats_cleaned = mlb_stats.drop(["Year", "Tm", "Winner", "fld_Rdrs", "fld_Rdrs/yr", "fld_Rgood", "fld_Rtot", "fld_Rtot/yr", "bat_SF"], axis = 1)

display(mlb_stats_cleaned)

# ---------- Split data (80% Training, 20% Testing) ----------

X = mlb_stats_cleaned.drop(columns = ['WS_win'])
Y = mlb_stats_cleaned['WS_win']

## Split data
X_train, X_test, y_train, y_test = train_test_split(X,
                                                    Y,
                                                    test_size = 0.2,
                                                    random_state = 524,
                                                    stratify = Y)

## Standardize X_train and X_test
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)

X_test_scaled = scaler.transform(X_test)

# ---------- Logistic Regression ----------

## Define k-fold validation
K = 10

kfold = StratifiedKFold(K,
                        random_state = 1110,
                        shuffle = True)

## Build Logistic Regression model
log_model = LogisticRegression(C = 1.0,
                               max_iter = 15000,
                               class_weight = 'balanced')

logistic_result = log_model.fit(X_train_scaled, y_train)

# ---------- Cross - Validation for C ----------

params = {'C': [0.001, 0.01, 0.1, 1, 10, 100]}

grid_logR = GridSearchCV(log_model,
                         params,
                         cv = kfold,
                         scoring = 'f1')

## Find best C and gamma
grid_logR.fit(X_train_scaled, y_train)

display(grid_logR.best_params_)

current_C = grid_logR.best_params_['C']
print(f"Optimal C: {current_C}")

# ---------- Refit Logistic Regression Model Using Optimal C ----------

log_model_opt = LogisticRegression(C = current_C,
                                   max_iter = 15000,
                                   class_weight = 'balanced')

logistic_opt_result = log_model_opt.fit(X_train_scaled, y_train)

# ---------- Coefficients ----------

logistic_opt_coef = pd.DataFrame({'Feature': X_train.columns,
                                  'Coefficient': log_model_opt.coef_[0]})

logistic_opt_coef = logistic_opt_coef.sort_values('Coefficient', ascending = False)

display(logistic_opt_coef.head(10))

# ---------- Predict on Test Data ----------

## Predict trained model on X_test_scaled
y_pred_logR = log_model_opt.predict(X_test_scaled)

print(confusion_matrix(y_test, y_pred_logR))

print(classification_report(y_test, y_pred_logR))

## Construct Confusion Matrix
c_matrix = confusion_matrix(y_test, y_pred_logR)

ConfusionMatrixDisplay(c_matrix, display_labels = ['No WS Win', 'WS Win']).plot()
plt.show()

precision, recall, thresholds = precision_recall_curve(y_test, y_pred_logR)

# Get the predicted probabilities
y_probs = log_model_opt.predict_proba(X_test_scaled)[:, 1]

# Calculate the precision and recall values
precision, recall, thresholds = precision_recall_curve(y_test, y_probs)

# Calculate the AUC
pr_auc_score = auc(recall, precision)

print(f"The PR-AUC Score is: {pr_auc_score:.4f}")

plt.figure(figsize=(8, 6))
plt.plot(recall,
         precision,
         label  =f'Logistic + TWFE (PR-AUC = {pr_auc_score:.2f})',
         color = 'b')


plt.xlabel('Recall')
plt.ylabel('Precision')
plt.title('Precision-Recall Curve')
plt.legend()
plt.show()

# ---------- Save PR-AUC Globally ----------

## Save PR AUC to a df for global export
