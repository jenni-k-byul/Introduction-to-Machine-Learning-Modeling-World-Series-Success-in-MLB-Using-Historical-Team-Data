## Group stats by year
def group_files_by_year_from_name(directory_path):

    files = glob.glob(os.path.join(directory_path, '*.*'))

    files_by_year = {}

    for file in files:
        filename = os.path.basename(file)

        try:
            year_str = filename[0:4]
            year = int(year_str)

            if year not in files_by_year:
                files_by_year[year] = []

            files_by_year[year].append(file)

        except (ValueError, IndexError):
            print(f"Could not extract year from filename: {filename}")
            continue

    return files_by_year


## Set path to folder with seasonal stats from Baseball-Reference
files_grouped = group_files_by_year_from_name('')

