def combine_files_for_each_year(files_by_year, output_directory):
    if not os.path.exists(output_directory):
        os.makedirs(output_directory)

    for year, files_list in files_by_year.items():

        dfs = []

        for file_path in files_list:
            df = pd.read_html(file_path)[0]

            # Remove League Average row
            df = df[df['Tm'] != 'League Average']

            # Drop rows with no team (total row)
            df = df.dropna(subset=['Tm'])

            # Add year column
            df['Year'] = year

            # Add prefix to each stat for improved interpretability
            filename = os.path.basename(file_path).lower()

            if 'batting' in filename:
                df = df.add_prefix('bat_')
                df = df.rename(columns = {'bat_Tm': 'Tm', 'bat_Year': 'Year'})
            elif 'fielding' in filename:
                df = df.add_prefix('fld_')
                df = df.rename(columns = {'fld_Tm': 'Tm', 'fld_Year': 'Year'})
            elif 'pitching' in filename:
                df = df.add_prefix('pit_')
                df = df.rename(columns = {'pit_Tm': 'Tm', 'pit_Year': 'Year'})

            dfs.append(df)

        # Merge all three types of stats horizontally on team name and year
        combined = dfs[0]

        for df in dfs[1:]:
            combined = combined.merge(df, on=['Tm', 'Year'])

        output_path = os.path.join(output_directory, f"complete_stat_{year}.csv")
        combined.to_csv(output_path, index = False)

        print(f"Created: {output_path} — {combined.shape[0]} teams, {combined.shape[1]} columns")


## Set output directory and run the merge function
output_dir = ''

combine_files_for_each_year(files_grouped, output_dir)


